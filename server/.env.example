# Server Port
PORT=5000

# Allowed Frontend Client Origin for CORS (Production: Vercel, Local: http://localhost:5173)
CLIENT_URL=https://cine-omega-peach.vercel.app

# Supabase Database Configuration
SUPABASE_URL=https://mxmimxtpxcjluzocsblh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Razorpay Payment Gateway (Server Secrets)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Transactional Email (Brevo / Sendinblue) - Optional
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=tickets@cinticket.com
BREVO_SENDER_NAME=CinTicket Cinema

# TMDB Movie Metadata API - Optional
TMDB_API_KEY=your_tmdb_api_key_here

# Booking Hold Policy
SEAT_HOLD_MINUTES=8
CONVENIENCE_FEE_PERCENT=0
